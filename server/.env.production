NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# sqlite — работает сразу | mssql — если SQL Server на bolashaq-srv
DB_DRIVER=sqlite
SQLITE_PATH=./data/bolashak_hr.db

SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=bolashak_hr
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true

JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_ON_SERVER
JWT_EXPIRES_IN=8h

# TailScale IP сервера (для CORS, если нужен отдельный фронт)
CLIENT_URL=http://100.121.80.67:3002,http://localhost:3002
